ORGANIZATION_BLOCK 程序块:OB1
TITLE=
BEGIN
Network 1 
// 程序段注释
LD     SM0.0
CALL   SBR33
CALL   SBR18
CALL   SBR13
CALL   SBR0
CALL   SBR16
CALL   SBR14
CALL   SBR11
CALL   SBR15
CALL   SBR7
CALL   SBR29
CALL   SBR32
CALL   SBR31
CALL   SBR43
CALL   SBR3
CALL   SBR28
CALL   SBR30
CALL   SBR27
END_ORGANIZATION_BLOCK
SUBROUTINE_BLOCK 开关机和回路协调:SBR0
TITLE=子程序注释
BEGIN
Network 1 
// 程序段注释
LD     SM0.1
R      V400.0, 90
R      M21.0, 16
R      V10.0, 30
Network 2 
LD     SM0.1
R      V1250.0, 24
Network 3 
// 制冷制热模式选择
LD     SM0.0
LPS
AN     V602.1
=      V200.0
LPP
AN     V200.0
=      V100.0
Network 4 
// 制冷制热模式切换时三通四通阀转换状态
LD     SM0.0
LPS
LD     V100.0
AN     V221.0
O      V602.3
O      V602.5
ALD
=      V404.0
LPP
AN     V404.0
=      V401.3
Network 5 
// 制冷制热模式切换时三通四通阀转换状态
LD     SM0.0
A      V100.0
AN     V220.3
=      V401.4
Network 6 
// 温度控制目标进水/出水切换
LD     SM0.0
LPS
AN     V602.0
MOVR   VD1178, VD2100
LPP
A      V602.0
MOVR   VD1170, VD2100
Network 7 
// 温度控制范围
LD     SM0.0
MOVR   VD1600, VD1608
+R     VD1604, VD1608
MOVR   VD1600, VD1612
-R     VD1604, VD1612
Network 8 
LD     SM0.0
LPS
A      V412.6
=      V1099.5
LRD
A      SM0.1
S      M24.0, 1
LRD
A      M24.0
=      V1099.4
AN     V1099.7
=      V403.1
LRD
LDN    M24.0
A      V20.7
LD     M24.0
A      V1099.5
OLD
ALD
LPS
A      T137
AN     V1099.7
A      C66
AN     V5.5
LPS
EU
R      M14.1, 3
R      T240, 1
R      V36.0, 2
S      M22.0, 1
S      V30.2, 1
LPP
ED
S      V45.0, 1
R      M22.0, 1
LPP
=      M22.2
LPP
LPS
LD     M22.2
LDN    M24.0
A      M3.0
OLD
ALD
TON    T137, VW650
LPP
A      V412.7
=      V60.2
Network 9 
// 根据温度判断开压缩机
LD     SM0.0
A      M22.0
LPS
LD     V200.0
AR>    VD2100, VD1608
LD     V100.0
AR<    VD2100, VD1612
OLD
ALD
=      V2000.0
LRD
LPS
A      V2000.0
TON    T213, VW660
LPP
A      T213
S      V10.0, 1
LRD
LD     T190
O      T245
ALD
R      V10.0, 1
LPP
NOT
R      V10.0, 1
Network 10 
// 无故障，安全时间清零，压缩机启动
LD     V10.0
AN     V9.0
AN     V55.0
AN     V603.0
LPS
EU
S      V10.2, 1
LPP
ED
R      V10.2, 1
Network 11 
// 运行信号故障信号输出
LD     SM0.0
LPS
A      M22.2
=      V402.3
LPP
A      V1099.7
=      V402.4
END_SUBROUTINE_BLOCK
SUBROUTINE_BLOCK PID0_CTRL:SBR1
TITLE=此 POU 由 S7-200 指令向导的 PID 公式创建.
// 要在程序中启用此组态，请在每个扫描周期使用 SM0.0 从 MAIN 程序块中调用此子例程.  该代码会组态 PID 0。有关从 VB15243 开始的 PID 回路变量表的详细信息，请参见 DB1.  此子例程将初始化 PID 控制逻辑使用的变量并启动 PID 中断 "PID_EXE" 例程. 按照 PID 采样时间循环调用 PID 中断例程. 有关 PID 指令的完整描述，请参见 S7-200 系统手册. 注意：当 PID 处于手动模式时，应通过向手动输出参数写入标准化值 (0.00 to 1.00) 来控制输出，而不是直接更改输出. 这样便会在 PID 返回自动模式时自动提供无扰动传送. 
VAR_INPUT
PV_I:INT;	// 过程变量输入：范围 0 到 27648
Setpoint_R:REAL;	// 设定值输入：范围 0.0 到 100.0
END_VAR
VAR_OUTPUT
Output:INT;	// PID 输出：范围 0 到 27648
END_VAR
VAR
Tmp_DI:DWORD;
Tmp_R:REAL;
Tmp_Timer:DWORD;
END_VAR
BEGIN
Network 1 // 此 POU 针对编辑和查看设置了密码保护.

END_SUBROUTINE_BLOCK
SUBROUTINE_BLOCK PID1_CTRL:SBR2
TITLE=此 POU 由 S7-200 指令向导的 PID 公式创建.
// 要在程序中启用此组态，请在每个扫描周期使用 SM0.0 从 MAIN 程序块中调用此子例程.  该代码会组态 PID 1。有关从 VB12603 开始的 PID 回路变量表的详细信息，请参见 DB1.  此子例程将初始化 PID 控制逻辑使用的变量并启动 PID 中断 "PID_EXE" 例程. 按照 PID 采样时间循环调用 PID 中断例程. 有关 PID 指令的完整描述，请参见 S7-200 系统手册. 注意：当 PID 处于手动模式时，应通过向手动输出参数写入标准化值 (0.00 to 1.00) 来控制输出，而不是直接更改输出. 这样便会在 PID 返回自动模式时自动提供无扰动传送. 
VAR_INPUT
PV_I:INT;	// 过程变量输入：范围 0 到 27648
Setpoint_R:REAL;	// 设定值输入：范围 0.0 到 100.0
END_VAR
VAR_OUTPUT
Output:INT;	// PID 输出：范围 0 到 27648
END_VAR
VAR
Tmp_DI:DWORD;
Tmp_R:REAL;
Tmp_Timer:DWORD;
END_VAR
BEGIN
Network 1 // 此 POU 针对编辑和查看设置了密码保护.

END_SUBROUTINE_BLOCK
SUBROUTINE_BLOCK 安全时间油预热:SBR3
TITLE=
BEGIN
Network 1 
// 压缩机停止开始倒计时间安全时间
LD     SM0.5
EU
LD     C65
CTU    C65, +1
Network 2 
LD     C65
EU
LD     V55.0
EU
CTD    C66, VW608
Network 3 
LD     V55.0
AW=    C66, +0
LD     V70.2
EU
OLD
R      V55.0, 1
R      C66, 1
Network 4 
LD     V400.0
ED
S      V55.0, 1
Network 5 
// 上电后油预热时间开始倒计时
LD     SM0.5
EU
LD     C67
CTU    C67, +1
Network 6 
LD     C67
EU
LD     V5.5
EU
CTD    C80, VW624
Network 7 
LD     V5.5
AW=    C80, +0
LD     V70.3
EU
OLD
R      V5.5, 1
R      C80, 1
Network 8 
LD     SM0.1
S      V5.5, 1
Network 9 
LD     SM0.0
MOVW   C66, VW4500
MOVW   C80, VW4502
END_SUBROUTINE_BLOCK
SUBROUTINE_BLOCK 外部通讯:SBR4
TITLE=
BEGIN
Network 1 
Network 2 
LD     SM0.1
R      V7000.0, 8
CALL   SBR34, 1, VB7990, VD7992, VB7991, 1, 0, 0, 0, 900, &VB7000, V7990.0, VB7996
Network 3 
LD     SM0.0
CALL   SBR35, V7999.1, VB7997
Network 4 
LD     SM0.0
LPS
A      V1251.4
=      V7001.5
LRD
A      V1251.3
=      V7001.7
LRD
A      V1250.3
=      V7003.2
LPP
A      V1250.2
=      V7000.1
Network 5 
// 只读数据
LD     SM0.0
MOVR   VD1170, VD7024
MOVR   VD1178, VD7028
MOVR   VD1186, VD7048
MOVR   VD1194, VD7044
MOVR   VD1148, VD7020
Network 6 
// 可读写数据
LD     SM0.0
MOVR   VD7056, VD1600
MOVR   VD7060, VD1604
MOVR   VD1600, VD7056
MOVR   VD1604, VD7060
A      M24.0
A      V7006.4
=      V602.1
END_SUBROUTINE_BLOCK
