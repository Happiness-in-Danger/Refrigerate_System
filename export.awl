SUBROUTINE_BLOCK 计算饱和温度:SBR26
TITLE=子程序注释
VAR_INPUT
表压Bar:REAL;
END_VAR
VAR_IN_OUT
饱和温度Tsat:REAL;
END_VAR
VAR
绝压MPa:REAL;
END_VAR
BEGIN
Network 1 
// 蒸发温度
LD     SM0.0
MOVR   LD0, AC0
AENO
+R     1.0, AC0
AENO
MOVR   AC0, LD8
/R     10.0, LD8
Network 2 
// 程序段注释
LD     SM0.0
LPS
AR<=   LD8, 0.2
CALL   SBR23, LD8, -298188.0, 312145.0, -141126.0, 36231.0, -5936.0, 744.6, -66.402, AC0
LRD
AR>    LD8, 0.2
AR<    LD8, 0.4
CALL   SBR23, LD8, -4431.5, 9585.1, -8944.2, 4734.9, -1599.7, 416.27, -55.697, AC0
LRD
AR>=   LD8, 0.4
CALL   SBR23, LD8, -2.5377, 21.623, -77.156, 151.03, -181.99, 163.78, -35.358, AC0
LPP
*R     100.0, AC0
AENO
ROUND  AC0, AC0
AENO
DTR    AC0, AC1
AENO
MOVR   AC1, LD4
/R     100.0, LD4
END_SUBROUTINE_BLOCK
SUBROUTINE_BLOCK 累积运行时间:SBR27
TITLE=累计运行时间
BEGIN
Network 1 
// 压缩机1累积运行计时（分钟）
LD     V100.5
A      SM0.4
EU
LD     C10
CTU    C10, +60
Network 2 
// C11：压缩机累计运行时间（小时）
LD     C10
EU
LDN    SM0.0
CTU    C11, +32000
Network 3 
// 机组总运行计时（分钟）
LD     M22.0
A      SM0.4
EU
LD     C14
CTU    C14, +60
Network 4 
// C15：机组总累计运行时间（小时）
LD     C14
EU
LDN    SM0.0
CTU    C15, +32000
Network 5 
LD     SM0.0
MOVW   C15, VW2600
Network 6 
// 机组单次运行计时（分钟）
LD     M22.0
A      SM0.4
EU
LD     C16
CTU    C16, +60
Network 7 
// C15：机组单次计运行时间（小时）。
LD     C16
EU
LDN    SM0.0
CTU    C17, +32000
Network 8 
LD     SM0.0
MOVW   C17, VW2728
MOVW   C16, VW2730
AN     M22.0
MOVW   0, C17
MOVW   0, C16
END_SUBROUTINE_BLOCK
