SUBROUTINE_BLOCK 模拟量输入:SBR13
TITLE=
BEGIN
Network 1 
LD     SM0.0
CALL   SBR6, AIW32, 27648.0, 5529.6, 10.0, 0.0, VD1008, VD1000
CALL   SBR6, AIW34, 27648.0, 5529.6, 10.0, 0.0, VD1012, VD1004
CALL   SBR6, AIW38, 27648.0, 5529.6, 10.0, 0.0, VD1074, VD1132
CALL   SBR6, AIW40, 27648.0, 5529.6, 20.0, 0.0, VD1070, VD1128
CALL   SBR6, AIW42, 27648.0, 5529.6, 450.0, 0.0, VD1086, VD1148
CALL   SBR6, AIW44, 27648.0, 5529.6, 150.0, -50.0, VD1090, VD1150
CALL   SBR6, AIW46, 27648.0, 5529.6, 20.0, 0.0, VD1094, VD1154
Network 2 
LD     SM0.0
CALL   SBR21, AIW36, 27648, 5530, VD1616, VD1620, AC0
MOVR   AC0, VD1124
+R     VD1624, VD1124
MOVR   VD1124, VD1628
-R     50.0, VD1628
Network 3 
LD     SM0.0
LPS
MOVW   AIW48, AC0
AENO
ITD    AC0, AC0
AENO
DTR    AC0, AC0
AENO
/R     10.0, AC0
AENO
MOVR   AC0, VD1170
+R     VD1716, VD1170
LRD
MOVW   AIW50, AC1
AENO
ITD    AC1, AC1
AENO
DTR    AC1, AC1
AENO
/R     10.0, AC1
AENO
MOVR   AC1, VD1178
+R     VD1720, VD1178
LRD
MOVW   AIW52, AC2
AENO
ITD    AC2, AC2
AENO
DTR    AC2, AC2
AENO
/R     10.0, AC2
AENO
MOVR   AC2, VD1174
+R     VD1724, VD1174
LPP
MOVW   AIW54, AC3
AENO
ITD    AC3, AC3
AENO
DTR    AC3, AC3
AENO
/R     10.0, AC3
AENO
MOVR   AC3, VD1194
+R     VD1728, VD1194
Network 4 
LD     SM0.0
LPS
MOVW   AIW64, AC0
AENO
ITD    AC0, AC0
AENO
DTR    AC0, AC0
AENO
/R     10.0, AC0
AENO
MOVR   AC0, VD1100
+R     VD1096, VD1100
LPP
MOVW   AIW68, AC1
AENO
ITD    AC1, AC1
AENO
DTR    AC1, AC1
AENO
/R     10.0, AC1
AENO
MOVR   AC1, VD1104
+R     VD1046, VD1104
Network 5 
LD     SM0.0
LPS
AR>    VD1100, 80.0
