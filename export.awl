// 
// PASSWORD
// The password of the library is "1234"
// 
// ABS_R
// Absolute Function for real (floating point) value
// 
// OUT= | IN | 
// 
// Range of values: 
//                                 x <   -3.40282*10^ 38 will be rouded to -INF
// -3.40282*10^ 38 <= x <= -1           *10^-37 will be converted
// -1           *10^-37 <   x <    1           *10^-37 will be rouded to 0
//  1           *10^-37 <= x <=  3.40282*10^ 38 will be converted
//  3.40282*10^ 38 <   x		   will be rouded to INF
// 
// Inputs/Outputs	Operands							Data Types
// IN		VD, ID, QD, MD, SD, SMD, LD, AC, Constant, *VD, *LD, *AC	REAL
// OUT		VD, ID, QD, MD, SD, SMD, LD, AC, *VD, *LD, *AC		REAL
// MICRO PRM
VAR_INPUT
IN:REAL;	// Floating Point Input Value
END_VAR
VAR_OUTPUT
OUT:REAL;	// Floating Point Output Value
END_VAR
BEGIN
Network 1 // 此 POU 针对编辑和查看设置了密码保护.

END_SUBROUTINE_BLOCK
SUBROUTINE_BLOCK 冷冻水泵:SBR10
TITLE=子程序注释
BEGIN
Network 1 
// 冷冻水泵在开机时使能，关机后延时断开使能；停机状态下环境温度低于设定值时水泵启动，高于设定值时停止
LD     SM0.0
LPS
LD     M22.2
LDN    M22.2
LD     V100.4
O      V300.1
ALD
OLD
ALD
AN     V1099.7
AN     V1250.2
=      V401.6
LPP
AN     M22.2
LDR<=  VD1194, 7.0
LD     V300.1
AR<=   VD1194, 8.0
OLD
ALD
=      V300.1
END_SUBROUTINE_BLOCK
SUBROUTINE_BLOCK 制冷电子膨胀阀:SBR11
TITLE=
BEGIN
Network 1 
LD     SM0.1
MOVR   0.0, VD5000
Network 2 
// 压缩机开机前到开机后保持时间结束前向膨胀阀写入初始开度
LD     SM0.0
LPS
LD     V200.0
A      V100.4
LD     V100.0
A      V220.0
OLD
O      V351.0
ALD
=      V400.7
TON    T203, VW790
LPP
LPS
A      V400.7
AN     T203
CALL   SBR21, VW622, 100, 0, 100.0, 0.0, VD5000
LPP
A      V100.5
ED
MOVR   0.0, VD5000
Network 3 
// 膨胀阀开度根据液位控制
LD     SM0.0
A      V400.7
A      T203
CALL   SBR19, VD1124, 100.0, 0.0, 27648, 0, VW5204
CALL   SBR1, VW5204, 50.0, VW870
CALL   SBR21, VW792, 100, 0, 100.0, 0.0, AC0
CALL   SBR21, VW870, 27648, 0, 100.0, AC0, VD5000
Network 4 
// 膨胀阀开度转换为0~1000整数
LD     SM0.0
LPS
AN     V351.0
MOVR   VD5000, AC0
AENO
*R     10.0, AC0
AENO
TRUNC  AC0, AC0
AENO
DTI    AC0, VW4950
LPP
A      V351.0
MOVR   VD5044, AC0
AENO
*R     10.0, AC0
AENO
TRUNC  AC0, AC0
AENO
DTI    AC0, VW4950
Network 5 
// 读出膨胀阀开度
LD     SM0.0
MOVW   VW4960, AC0
AENO
/I     +10, AC0
AENO
ITD    AC0, AC0
AENO
DTR    AC0, VD5980
END_SUBROUTINE_BLOCK
