SUBROUTINE_BLOCK 模拟量转换加修正:SBR6
TITLE=
VAR_INPUT
模拟量当前值:INT;
模拟量上限:REAL;
摸拟量下限:REAL;
工程量上限:REAL;
工程量下限:REAL;
修正值:REAL;
END_VAR
VAR_OUTPUT
工程量当前值:REAL;
END_VAR
BEGIN
Network 1 
LD     SM0.0
ITD    LW0, LD26
DTR    LD26, LD30
Network 2 
LD     SM0.0
MOVR   LD10, LD34
-R     LD14, LD34
MOVR   LD2, LD38
-R     LD6, LD38
MOVR   LD30, LD46
-R     LD6, LD46
MOVR   LD34, LD50
*R     LD46, LD50
MOVR   LD50, LD54
/R     LD38, LD54
MOVR   LD54, LD42
+R     LD14, LD42
MOVR   LD42, LD22
+R     LD18, LD22
END_SUBROUTINE_BLOCK
SUBROUTINE_BLOCK 经济器电子膨胀阀:SBR7
TITLE=子程序注释
BEGIN
Network 1 
LD     SM0.1
MOVR   0.0, VD5032
Network 2 
// 制热模式下，吸气压力低于设定值时开启经济器电磁阀
LD     SM0.0
LPS
A      V10.2
AN     V220.0
A      V100.0
LPS
AR<    VD1132, VD614
TON    T180, +30
LRD
AR>=   VD1132, VD618
TON    T181, +30
LRD
A      T180
S      V401.5, 1
LRD
A      T181
R      V401.5, 1
LPP
ED
R      V401.5, 1
LPP
A      V351.2
LPS
EU
S      V401.5, 1
LPP
ED
R      V401.5, 1
Network 3 
// 压缩机开机前到开机后保持时间结束前向膨胀阀写入初始开度
LD     SM0.0
A      V401.5
ED
MOVR   0.0, VD5032
Network 4 
LD     SM0.0
CALL   SBR26, VD1154, VD5016
MOVR   VD1150, VD5020
-R     VD5016, VD5020
Network 5 
LD     SM0.0
A      V401.5
CALL   SBR19, VD5020, 20.0, 0.0, 27648, 0, VW5208
CALL   SBR5, VW5208, 25.0, AC1
CALL   SBR21, 30, 100, 0, 100.0, 0.0, AC0
CALL   SBR21, AC1, 27648, 0, 100.0, AC0, VD5032
Network 6 
// 膨胀阀开度转换为0~1000整数
LD     SM0.0
LPS
AN     V351.2
MOVR   VD5032, AC0
AENO
*R     10.0, AC0
AENO
TRUNC  AC0, AC0
AENO
DTI    AC0, VW4930
LPP
A      V351.2
MOVR   VD5052, AC0
AENO
*R     10.0, AC0
AENO
TRUNC  AC0, AC0
AENO
DTI    AC0, VW4930
Network 7 
// 读出膨胀阀开度
LD     SM0.0
MOVW   VW4940, AC0
AENO
/I     +10, AC0
AENO
ITD    AC0, AC0
AENO
DTR    AC0, VD5040
END_SUBROUTINE_BLOCK
SUBROUTINE_BLOCK 比例:SBR8
TITLE=
VAR_INPUT
输入:INT;
上限:REAL;
下限:REAL;
校正:DINT;
END_VAR
VAR_OUTPUT
输出:INT;
故障:BOOL;
END_VAR
BEGIN
Network 1 
LDW>   LW0, +4000
OW<    LW0, +800
=      L16.0
Network 2 
LDW>   LW0, +4000
MOVW   +4000, LW0
Network 3 
LDW<   LW0, +800
MOVW   +800, LW0
Network 4 
LD     SM0.0
-R     LD6, LD2
MOVW   LW0, LW17
-I     +800, LW17
ITD    LW17, LD19
DTR    LD19, LD23
MOVR   LD23, LD27
*R     LD2, LD27
Network 5 
LD     SM0.0
MOVR   LD27, LD31
/R     3200.0, LD31
MOVR   LD6, LD35
+R     LD31, LD35
Network 6 
LD     SM0.0
MOVR   LD35, LD51
/R     100.0, LD51
DTR    LD10, LD39
MOVR   LD39, LD43
*R     LD51, LD43
MOVR   LD43, LD55
+R     LD35, LD55
ROUND  LD55, LD47
DTI    LD47, LW14
END_SUBROUTINE_BLOCK
SUBROUTINE_BLOCK ABS_R:SBR9
TITLE=                                               
//                                                                            LIBARY: SIGN OPERATION 
//                                                                            =======================
// 
// 
// LIABILITY
// Siemens AG does not accept liability of any kind for damages arising from the use of this application, except where it is obliged to by law, in cases such as damage to items used for personal purposes, personal injury, willful damage or gross negligence.
