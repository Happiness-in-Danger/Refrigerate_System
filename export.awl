SUBROUTINE_BLOCK 饱和温度计算模块:SBR23
TITLE=
VAR_INPUT
绝对压力MPa:REAL;
次方6系数:REAL;
次方5系数:REAL;
次方4系数:REAL;
次方3系数:REAL;
次方2系数:REAL;
次方1系数:REAL;
次方0系数:REAL;
END_VAR
VAR_OUTPUT
输出量:REAL;
END_VAR
BEGIN
Network 1 
// 绝压
LD     SM0.0
MOVR   LD0, LD36
Network 2 
// 5-6次方
LD     SM0.0
LPS
LN     LD36, AC0
AENO
*R     6.0, AC0
AENO
EXP    AC0, AC0
AENO
*R     LD4, AC0
LRD
LN     LD36, AC1
AENO
*R     5.0, AC1
AENO
EXP    AC1, AC1
AENO
*R     LD8, AC1
LPP
MOVR   AC0, LD40
+R     AC1, LD40
Network 3 
// 3-4次方
LD     SM0.0
LPS
LN     LD36, AC0
AENO
*R     4.0, AC0
AENO
EXP    AC0, AC0
AENO
*R     LD12, AC0
LRD
LN     LD36, AC1
AENO
*R     3.0, AC1
AENO
EXP    AC1, AC1
AENO
*R     LD16, AC1
LPP
MOVR   AC0, LD44
+R     AC1, LD44
Network 4 
// 1-2次方
LD     SM0.0
LPS
LN     LD36, AC0
AENO
*R     2.0, AC0
AENO
EXP    AC0, AC0
AENO
*R     LD20, AC0
LRD
MOVR   LD36, AC1
*R     LD24, AC1
LPP
MOVR   AC0, LD48
+R     AC1, LD48
Network 5 
LD     SM0.0
MOVR   LD40, AC1
AENO
+R     LD44, AC1
AENO
+R     LD48, AC1
AENO
MOVR   AC1, LD32
+R     LD28, LD32
END_SUBROUTINE_BLOCK
