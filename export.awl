Network 2 
// V220.0开膨胀阀，V220.3四通阀，液管阀，翅片风机断电，V220.1开始检测退出除霜条件，V221.0三通阀断电，V221.1三通阀通电，V220.2四通阀，液管阀，翅片风机通电
LD     SM0.0
LPS
A      V220.0
TON    T250, 200
A      T250
EU
S      V220.3, 1
LRD
A      V220.3
LPS
TON    T248, +600
A      T248
EU
S      V220.1, 1
LRD
TON    T212, VW638
LPP
A      T212
EU
S      V221.0, 1
LRD
A      V220.1
AR>=   VD7894, VD804
TON    T252, 20
A      T252
EU
S      V221.0, 1
LRD
A      V221.0
LPS
AR>    VD1128, 9.5
TON    T200, 100
LRD
TON    T202, 1800
LPP
LD     T200
O      T202
ALD
EU
S      V221.1, 1
LPP
A      V221.1
TON    T201, 100
A      T201
EU
S      V220.2, 1
Network 3 
LD     SM0.0
A      V220.3
A      V220.2
TON    T153, 100
A      T153
EU
R      V220.0, 1
R      V220.3, 1
R      V220.1, 1
R      V220.2, 1
R      V220.1, 1
R      V220.0, 1
R      V221.0, 1
R      V221.1, 1
Network 4 
// 除霜时卸载阀/加载阀/制热电磁阀/四通阀/翅片风机的启动停止
LD     SM0.0
A      V220.0
EU
R      V403.2, 1
R      V400.4, 1
R      V133.0, 2
END_SUBROUTINE_BLOCK
SUBROUTINE_BLOCK 制热电子膨胀阀:SBR15
TITLE=子程序注释
BEGIN
Network 1 
LD     SM0.1
MOVR   0.0, VD5012
Network 2 
// 压缩机开机前到开机后保持时间结束前向膨胀阀写入初始开度
LD     SM0.0
LPS
LD     V100.0
A      V100.4
AN     V220.0
O      V351.1
ALD
=      V401.7
TON    T56, VW790
LPP
LPS
A      V401.7
AN     T56
CALL   SBR21, VW626, 100, 0, 100.0, 0.0, VD5012
LPP
A      V100.5
ED
MOVR   0.0, VD5012
Network 3 
LD     SM0.0
CALL   SBR26, VD1132, VD7810
MOVR   VD1104, VD5024
-R     VD7810, VD5024
Network 4 
LD     SM0.0
A      V401.7
A      T56
CALL   SBR19, VD5024, 20.0, 0.0, 27648, 0, VW5206
CALL   SBR2, VW5206, 25.0, AC1
CALL   SBR21, VW792, 100, 0, 100.0, 0.0, AC0
CALL   SBR21, VW870, 27648, 0, 100.0, AC0, VD5028
Network 5 
// 膨胀阀开度转换为0~1000整数
LD     SM0.0
LPS
AN     V351.1
MOVR   VD5028, AC0
AENO
*R     10.0, AC0
AENO
TRUNC  AC0, AC0
AENO
DTI    AC0, VW4970
LPP
A      V351.1
MOVR   VD5048, AC0
AENO
*R     10.0, AC0
AENO
TRUNC  AC0, AC0
AENO
DTI    AC0, VW4970
Network 6 
// 读出膨胀阀开度
LD     SM0.0
MOVW   VW4980, AC0
AENO
/I     +10, AC0
AENO
ITD    AC0, AC0
AENO
DTR    AC0, VD5036
END_SUBROUTINE_BLOCK
